msgstr "Przejdź na PRO"

#: src/Admin/ProUpsell.php:94
msgid "Powiadom mnie"
msgstr "Powiadom mnie"

#: src/Admin/ProUpsell.php:94
msgid "Get notified"
msgstr "Powiadom mnie"

#: src/Admin/ProUpsell.php:124
msgid "Permission denied."
msgstr "Brak uprawnień."

