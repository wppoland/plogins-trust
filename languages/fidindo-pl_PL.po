#. Plugin Name of the plugin
#: fidindo.php
msgid "Fidindo - Trust Badges for WooCommerce"
msgstr ""

#. Plugin URI of the plugin
#: fidindo.php
msgid "https://plogins.com/plogins-trust/"
msgstr ""

#. Description of the plugin
#: fidindo.php
msgid ""
"Show trust and secure-checkout badges to boost buyer confidence and "
"conversions."
msgstr ""
"Wyświetlaj odznaki zaufania i bezpiecznych płatności, aby zwiększyć zaufanie "
"kupujących i konwersję."

#. Author of the plugin
#: fidindo.php
msgid "WPPoland.com"
msgstr ""

#. Author URI of the plugin
#: fidindo.php
msgid "https://wppoland.com"
msgstr ""

